# RootCause Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0

# AWS & Bedrock Configuration (Optional - falls back seamlessly to local if not provided)
AWS_REGION=us-east-1
USE_BEDROCK=false
BEDROCK_MODEL_ID=amazon.titan-text-express-v1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# DynamoDB Configuration (Optional - uses local thread-safe memory storage by default)
SUPPLIES_TABLE=rootcause-supplies
DEMANDS_TABLE=rootcause-demands
ALLOCATIONS_TABLE=rootcause-allocations
